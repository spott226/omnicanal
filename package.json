{
  "name": "nexoia-preview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:web": "vinext dev",
    "dev:api": "tsx watch --tsconfig apps/api/tsconfig.json apps/api/src/main.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vinext build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start": "vinext start",
    "start:api": "node apps/api/dist/apps/api/src/main.js",
    "test": "npm run test:web && npm run test:api",
    "test:web": "npm run build:web && node --test tests/rendered-html.test.mjs",
    "test:api": "tsx --tsconfig apps/api/tsconfig.json --test apps/api/test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern apps/api/dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-postgres.ps1",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/status-postgres.ps1",
    "db:seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx prisma/reset-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.1",
    "bcryptjs": "3.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "helmet": "8.1.0",
    "ioredis": "5.8.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/cookie-parser": "1.4.10",
    "@types/supertest": "6.0.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "prisma": "6.19.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
