# Aplicación
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
DATABASE_URL=postgresql://nexoia:nexoia@localhost:5432/nexoia
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-at-least-32-random-characters
CREDENTIALS_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# IA (el proveedor simulado funciona sin clave)
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=nexo-demo-v1
LLM_TIMEOUT=30000
LLM_MAX_OUTPUT_TOKENS=350

# Meta (dejar vacío durante la preview)
META_APP_SECRET=
META_VERIFY_TOKEN=
